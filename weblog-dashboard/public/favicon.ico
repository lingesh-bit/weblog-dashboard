<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <!-- Outer Dark Container matching .brand-mark -->
  <rect width="64" height="64" rx="12" fill="#0b0e14"/>
  <rect x="2" y="2" width="60" height="60" rx="10" fill="rgba(255, 176, 0, 0.12)" stroke="#ffb000" stroke-width="2.5" stroke-opacity="0.6"/>
  <!-- Glowing Amber Brand Icon matching '⌁' symbol -->
  <text x="32" y="44" font-family="'IBM Plex Mono', 'Courier New', monospace" font-size="38" font-weight="bold" fill="#ffb000" text-anchor="middle">⌁</text>
</svg>
